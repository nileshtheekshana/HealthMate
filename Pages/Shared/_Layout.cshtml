<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthMate</title>
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HealthMate.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white shadow-sm mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/images/icon/weblogo.png" alt="HealthMate" height="90" class="logo">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-animated" asp-area="" asp-page="/Admin/Dashboard">Admin Dashboard</a>
                            </li>
                        }
                        else if (User.IsInRole("Doctor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-animated" asp-area="" asp-page="/Doctor/Portal">Doctor Portal</a>
                            </li>
                        }
                        else if (User.IsInRole("Patient"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-animated" asp-area="" asp-page="/MyAppointments">My Appointments</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark nav-link-animated" asp-area="" asp-page="/Awareness">Awareness</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark nav-link-animated" asp-area="" asp-page="/AboutUs">About Us</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5>HealthMate</h5>
                    <p>+94 71 0 225 225</p>
                    <p>info@healthmate.com</p>
                    <p>HealthMate PLC, No: 108, W A D Ramanayake Mawatha, Colombo 2, Sri Lanka.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5>Other</h5>
                    <p><a asp-page="/Privacy">Terms and Conditions</a></p>
                    <p><a href="#">FAQ</a></p>
                    <p><a href="#">Feedback</a></p>
                    <p><a asp-page="/Privacy">Privacy Policy</a></p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5>About</h5>
                    <p><a asp-page="/AboutUs">The Company</a></p>
                    <p><a href="#">Investor Relations</a></p>
                    <p><a href="#">Partners</a></p>
                    <p><a href="#">Awards</a></p>
                    <p><a href="#">Careers</a></p>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-6 text-center text-md-start">
                    <p>&copy; 2026 - HealthMate - All Rights Reserved</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a href="#" class="me-3"><i class="fab fa-facebook fa-lg"></i></a>
                    <a href="#" class="me-3"><i class="fab fa-instagram fa-lg"></i></a>
                    <a href="#" class="me-3"><i class="fab fa-youtube fa-lg"></i></a>
                    <a href="#" class="me-3"><i class="fab fa-twitter fa-lg"></i></a>
                    <a href="#"><i class="fab fa-linkedin fa-lg"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>