@page
@model AboutUsModel
@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="text-primary">About HealthMate</h1>
        <p class="lead">Your Trusted Community Health Companion</p>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            <div class="card search-card text-white h-100">
                <div class="card-body">
                    <h3><i class="fas fa-bullseye me-2"></i>Our Mission</h3>
                    <p>To make healthcare accessible for everyone by connecting patients with qualified doctors, providing verified health information, and promoting preventive care across Sri Lanka.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card search-card text-white h-100">
                <div class="card-body">
                    <h3><i class="fas fa-eye me-2"></i>Our Vision</h3>
                    <p>To become the leading digital healthcare platform in Sri Lanka, empowering communities with easy access to medical services and health awareness.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12 text-center mb-4">
            <h2 class="text-primary">What We Offer</h2>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-calendar-check fa-3x text-primary mb-3"></i>
                    <h5>Online Appointments</h5>
                    <p>Book appointments with qualified doctors from the comfort of your home. Easy, fast, and convenient.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-heartbeat fa-3x text-primary mb-3"></i>
                    <h5>Health Awareness</h5>
                    <p>Access verified health tips, disease prevention information, and wellness guides.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-user-md fa-3x text-primary mb-3"></i>
                    <h5>Expert Doctors</h5>
                    <p>Connect with experienced and qualified doctors across various specializations.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card search-card text-white">
                <div class="card-body text-center py-4">
                    <h3>Contact Us</h3>
                    <p class="mb-1"><i class="fas fa-phone me-2"></i>+94 71 0 225 225</p>
                    <p class="mb-1"><i class="fas fa-envelope me-2"></i>info@healthmate.com</p>
                    <p class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>No: 108, W A D Ramanayake Mawatha, Colombo 2, Sri Lanka</p>
                </div>
            </div>
        </div>
    </div>
</div>