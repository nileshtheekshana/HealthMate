@page
@model AboutUsModel
@{
    ViewData["Title"] = "About Us";
}

<div class="container">
    <h1>About Us</h1>
    <p>Welcome to HealthMate - Your Community Health Companion</p>
    
    <div class="row mt-4">
        <div class="col-md-6">
            <h3>Our Mission</h3>
            <p>We help people manage appointments, access verified health info, and promote preventive care.</p>
        </div>
        <div class="col-md-6">
            <h3>Our Vision</h3>
            <p>Supporting health and well-being in communities through accessible healthcare services.</p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <h3>What We Offer</h3>
        </div>
        <div class="col-md-4 mt-3">
            <div class="card p-3">
                <h5>Online Appointments</h5>
                <p>Book appointments with doctors easily from home.</p>
            </div>
        </div>
        <div class="col-md-4 mt-3">
            <div class="card p-3">
                <h5>Health Awareness</h5>
                <p>Get verified health tips and information.</p>
            </div>
        </div>
        <div class="col-md-4 mt-3">
            <div class="card p-3">
                <h5>Patient Records</h5>
                <p>Access your medical history anytime.</p>
            </div>
        </div>
    </div>
</div>