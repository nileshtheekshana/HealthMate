@page
@model HealthMate.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<div class="container mt-4">
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Users</h5>
                    <h2>@Model.TotalUsers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Total Doctors</h5>
                    <h2>@Model.TotalDoctors</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Total Patients</h5>
                    <h2>@Model.TotalPatients</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Pending Appointments</h5>
                    <h2>@Model.PendingAppointments</h2>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mt-5 mb-3">Quick Actions</h4>
    <div class="row g-3">
        <div class="col-md-3">
            <a asp-page="/Admin/Doctors" class="btn btn-outline-primary w-100 p-4">
                <i class="fas fa-user-md fa-2x d-block mb-2"></i>
                <span>View Doctors</span>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-page="/Admin/AddDoctor" class="btn btn-outline-success w-100 p-4">
                <i class="fas fa-plus fa-2x d-block mb-2"></i>
                <span>Add Doctor</span>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-page="/Admin/Appointments" class="btn btn-outline-warning w-100 p-4">
                <i class="fas fa-calendar fa-2x d-block mb-2"></i>
                <span>View Appointments</span>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-page="/Admin/Users" class="btn btn-outline-info w-100 p-4">
                <i class="fas fa-users fa-2x d-block mb-2"></i>
                <span>View Users</span>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-page="/Admin/Services" class="btn btn-outline-secondary w-100 p-4">
                <i class="fas fa-cogs fa-2x d-block mb-2"></i>
                <span>Manage Services</span>
            </a>
        </div>
    </div>
</div>
