@page
@model HealthMate.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<div class="container mt-4">
    <h2>Admin Dashboard</h2>

    <div class="row mt-4">
        <div class="col-md-3 mb-3">
            <div class="card dashboard-card-1 text-white">
                <div class="card-body">
                    <h5>Total Users</h5>
                    <h2>@Model.TotalUsers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card dashboard-card-2 text-white">
                <div class="card-body">
                    <h5>Total Doctors</h5>
                    <h2>@Model.TotalDoctors</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card dashboard-card-3 text-white">
                <div class="card-body">
                    <h5>Total Patients</h5>
                    <h2>@Model.TotalPatients</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card dashboard-card-4 text-white">
                <div class="card-body">
                    <h5>Pending Appointments</h5>
                    <h2>@Model.PendingAppointments</h2>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mt-4">Quick Actions</h4>
    <div class="row mt-3">
        <div class="col-md-3 mb-3">
            <a asp-page="/Admin/Doctors" class="btn btn-gradient w-100 p-3">
                <i class="fas fa-user-md fa-2x"></i><br>View Doctors
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-page="/Admin/AddDoctor" class="btn btn-gradient w-100 p-3">
                <i class="fas fa-plus-circle fa-2x"></i><br>Add Doctor
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-page="/Admin/Appointments" class="btn btn-gradient w-100 p-3">
                <i class="fas fa-calendar-check fa-2x"></i><br>View Appointments
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-page="/Admin/Users" class="btn btn-gradient w-100 p-3">
                <i class="fas fa-users fa-2x"></i><br>View Users
            </a>
        </div>
    </div>
</div>
