@page
@model HealthMate.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h2>Admin Dashboard</h2>

    <div class="row mt-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5>Total Users</h5>
                    <h2>@Model.TotalUsers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5>Total Doctors</h5>
                    <h2>@Model.TotalDoctors</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5>Total Patients</h5>
                    <h2>@Model.TotalPatients</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h5>Pending Appointments</h5>
                    <h2>@Model.PendingAppointments</h2>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mt-4">Quick Actions</h4>
    <div class="row mt-3">
        <div class="col-md-3 mb-3">
            <a asp-page="/Admin/Doctors" class="btn btn-outline-primary w-100 p-3">
                <i class="bi bi-people"></i><br>View Doctors
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-page="/Admin/AddDoctor" class="btn btn-outline-success w-100 p-3">
                <i class="bi bi-plus"></i><br>Add Doctor
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-page="/Admin/Appointments" class="btn btn-outline-warning w-100 p-3">
                <i class="bi bi-calendar"></i><br>View Appointments
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-page="/Admin/Users" class="btn btn-outline-info w-100 p-3">
                <i class="bi bi-person"></i><br>View Users
            </a>
        </div>
    </div>
</div>
