@page
@model MyAppointmentsModel
@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">
    <h2>My Appointments</h2>

    @if (Model.Appointments.Any())
    {
        <table class="table table-striped mt-3">
            <thead>
                <tr>
                    <th>Doctor</th>
                    <th>Specialization</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var apt in Model.Appointments)
                {
                    <tr>
                        <td>Dr. @apt.Doctor?.Name</td>
                        <td>@apt.Doctor?.Specialization</td>
                        <td>@apt.AppointmentDate.ToString("MMM dd, yyyy")</td>
                        <td>@apt.TimeSlot</td>
                        <td>
                            @if (apt.Status == "Pending")
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (apt.Status == "Confirmed")
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                            else if (apt.Status == "Cancelled")
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@apt.Status</span>
                            }
                        </td>
                        <td>
                            @if (apt.Status == "Pending" || apt.Status == "Confirmed")
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-id="@apt.Id" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Cancel this appointment?')">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info mt-4">
            You have no appointments yet.
        </div>
        <a asp-page="/Index" class="btn btn-primary">Find a Doctor</a>
    }
</div>
