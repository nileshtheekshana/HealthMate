@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div id="banner" class="carousel slide rounded" data-bs-ride="carousel">
    <div class="carousel-inner rounded">
        <div class="carousel-item active">
            <img src="~/images/bannner/banner1.jpeg" class="d-block w-100 rounded" alt="Banner 1">
        </div>
        <div class="carousel-item">
            <img src="~/images/bannner/banner2.jpeg" class="d-block w-100 rounded" alt="Banner 2">
        </div>
        <div class="carousel-item">
            <img src="~/images/bannner/banner3.jpeg" class="d-block w-100 rounded" alt="Banner 3">
        </div>
    </div>
</div>

<div class="search-section bg-primary text-white rounded p-4 mt-4">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Doctor name</label>
            <input type="text" class="form-control" placeholder="Search Doctor Name">
        </div>
        <div class="col-md-3">
            <label class="form-label">Specialization</label>
            <select class="form-select">
                <option selected>Select Specialization</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Date</label>
            <input type="date" class="form-control" placeholder="MM/DD/YYYY">
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-secondary w-100">Search</button>
        </div>
    </div>
</div>
